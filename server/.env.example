# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# All routes are served under this prefix (frontend default expects /api).
API_PREFIX=/api
# Comma-separated list of allowed browser origins (strict allowlist).
# When left EMPTY, any http://localhost:<port> / http://127.0.0.1:<port> origin
# is allowed — handy in dev, where Vite hops to 5174/5175 if 5173 is busy.
# ALWAYS set this explicitly in production.
CORS_ORIGIN=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. Leave EMPTY to use the embedded PGlite database
# (real Postgres compiled to WASM, persisted to DATA_DIR/pg) — zero setup,
# ideal for local development. Use a real Postgres in production:
#   docker compose up -d db   →   postgres://lexai:lexai@localhost:5432/lexai
DATABASE_URL=
# Where PGlite data + local file uploads live.
DATA_DIR=./data

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Any long random string.
JWT_SECRET=change-me-in-production
# Access-token lifetime.
JWT_EXPIRES_IN=12h
# "demo": requests without a valid JWT are attributed to the seeded demo user,
#         so the unmodified frontend (whose auth store is still mocked) works
#         out of the box.
# "required": every request must carry a valid Bearer token (production).
AUTH_MODE=demo
# Password for the seeded demo account (a.rahman@freshfields.com).
SEED_DEMO_PASSWORD=lexai-demo

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
# When set, /analysis and chat replies are generated by Claude.
# When empty, the server falls back to deterministic canned output so the app
# still works end-to-end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console → APIs & Services → Credentials, and add GOOGLE_REDIRECT_URI to its
# "Authorized redirect URIs". Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Project settings → API. The SERVICE ROLE key bypasses Row Level Security:
# keep it server-side only, never commit it, never expose it to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for uploaded contracts (takes priority over S3/local).
SUPABASE_STORAGE_BUCKET=

# ── Monitoring & intake ───────────────────────────────────────────────────────
# Sentry error monitoring (empty = disabled).
SENTRY_DSN=
# Shared secret for POST /api/inbound/email (empty = endpoint disabled).
# Point your email provider's inbound webhook (Postmark/Mailgun/…) at that URL
# with header X-Inbound-Token: <this value>.
INBOUND_EMAIL_TOKEN=

# ── File storage ──────────────────────────────────────────────────────────────
# When S3_BUCKET is set, uploads go to S3 (credentials via the standard AWS
# chain: env vars, shared config, IAM role). When empty, files are stored on
# local disk under DATA_DIR/uploads and served from GET {API_PREFIX}/files/:key.
S3_BUCKET=
S3_REGION=us-east-1
# Optional: custom endpoint (MinIO, R2, …).
S3_ENDPOINT=
# Optional: public base URL for uploaded objects. When empty, presigned GET
# URLs (7 days) are returned.
S3_PUBLIC_URL=
