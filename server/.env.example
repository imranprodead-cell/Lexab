# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# All routes are served under this prefix (frontend default expects /api).
API_PREFIX=/api
# Comma-separated list of allowed browser origins (strict allowlist).
# When left EMPTY, any http://localhost:<port> / http://127.0.0.1:<port> origin
# is allowed — handy in dev, where Vite hops to 5174/5175 if 5173 is busy.
# ALWAYS set this explicitly in production.
CORS_ORIGIN=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. Leave EMPTY to use the embedded PGlite database
# (real Postgres compiled to WASM, persisted to DATA_DIR/pg) — zero setup,
# ideal for local development. Use a real Postgres in production:
#   docker compose up -d db   →   postgres://lexai:lexai@localhost:5432/lexai
DATABASE_URL=
# TLS to the database is validated against a CA certificate. The Supabase root
# CA ships in certs/supabase-root-2021-ca.pem and is used automatically; point
# this at another PEM for a different managed-Postgres provider.
DATABASE_CA_CERT_PATH=
# '1' disables DB TLS certificate validation (dev-only escape hatch — the
# connection stays encrypted but becomes MITM-able). Never use in production.
DATABASE_TLS_INSECURE=
# Where PGlite data + local file uploads live.
DATA_DIR=./data
# Max connections in the server's Postgres pool (default 10). ВАЖНО для
# Supabase: session pooler даёт всего ~15 сессий на проект — сервер (10) плюс
# любой ingest/eval-скрипт рядом уже упирается в лимит. Для скриптов запускайте
# их с PG_POOL_MAX=2, либо снизьте пул сервера.
PG_POOL_MAX=
# Fastify log verbosity: fatal|error|warn|info|debug|trace (default info).
LOG_LEVEL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Any long random string.
JWT_SECRET=change-me-in-production
# Access-token lifetime. The client silently renews via POST /auth/refresh
# once half the lifetime has passed, so any active user stays signed in.
JWT_EXPIRES_IN=30d
# Sessions older than this many days are pruned from the "active sessions"
# list by the daily sweep (SOC2 access review). Default 90.
SESSION_MAX_DAYS=90
# Dev-only escape hatch: '1' lets the server start WITHOUT JWT_SECRET /
# DATA_ENCRYPTION_KEY (ephemeral sessions, encryption off, loud warnings).
# NEVER set in production — leave empty.
ALLOW_INSECURE_SECRETS=
# Opt-in demo data seeding (demo user + sample contracts) for local development.
# MUST stay false/empty in production.
SEED_DEMO_DATA=false
# Password for the seeded demo account (a.rahman@freshfields.com).
SEED_DEMO_PASSWORD=lexab-demo

# ── Document encryption at rest ───────────────────────────────────────────────
# Master key for encrypting user documents / chat text in the database and in
# file storage (AES-256-GCM envelope, per-user data keys — src/lib/docCrypto.ts).
# REQUIRED in production: the server refuses to start without it, so nothing can
# ever be written unencrypted by accident. Generate a key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠ LOSING THIS KEY = PERMANENT LOSS of all encrypted documents. Keep a copy in
# a secrets manager / password vault. Independent of JWT_SECRET — rotating the
# JWT secret never affects document data.
DATA_ENCRYPTION_KEY=
# Set ONLY during a key rotation to the OLD key. Procedure:
#   1. DATA_ENCRYPTION_KEY = new key, DATA_ENCRYPTION_KEY_PREVIOUS = old key.
#   2. node --env-file=.env scripts/rotate-kek.ts   (re-wraps per-user DB keys).
#   3. Keep this set until every pre-rotation FILE is also re-saved under the new
#      key (stored files embed their key inline and are read via current→previous).
#      Only then may you unset it. See scripts/rotate-kek.ts for the full runbook.
DATA_ENCRYPTION_KEY_PREVIOUS=

# Dedicated key for sealing at-rest app secrets (the per-team SSO client secret).
# Decoupled from JWT_SECRET so rotating the JWT secret never makes SSO secrets
# undecryptable. Leave EMPTY to keep the legacy JWT-derived key (backward
# compatible; secrets sealed before still open, and a re-save upgrades them).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETS_ENCRYPTION_KEY=

# ── Compliance controls (Этап 5) ──────────────────────────────────────────────
# Reject known-breached passwords at register/change via the HIBP k-anonymity
# range API (only a SHA-1 prefix leaves the server). Fail-open on any network
# error. Set to 0 to disable (also disabled in tests — no network).
PASSWORD_BREACH_CHECK=1
# Days a soft-deleted document is kept (recoverable) before the daily retention
# sweep crypto-shreds it for good (rows + file bytes).
DATA_RETENTION_DAYS=30
# Batch/workflow background processing kicks off from the POST route. Set to 0
# only in tests (they drive the runners explicitly to stay deterministic).
BATCH_AUTOSTART=1

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
# When set, /analysis and chat replies are generated by Claude.
# When empty (or the model errors), the server FAILS LOUD (503) instead of
# fabricating legal content — required for a legal product. To use deterministic
# offline mocks for local development, set LLM_FALLBACK=dev below.
ANTHROPIC_API_KEY=
# 'dev' = deterministic offline mocks when the model is unavailable; anything
# else (default) = fail loud. NEVER set this to 'dev' in production.
LLM_FALLBACK=
# Default model for unknown plans (per-plan models below).
ANTHROPIC_MODEL=claude-opus-4-8
# Per-plan models — better plan, smarter model. Leave empty for these defaults:
# Free → DeepSeek when DEEPSEEK_API_KEY is set, otherwise claude-haiku-4-5;
# Standard → claude-sonnet-5, Pro → claude-opus-4-8,
# Business/Enterprise → claude-fable-5.
ANTHROPIC_MODEL_FREE=
ANTHROPIC_MODEL_STANDARD=
ANTHROPIC_MODEL_PRO=
ANTHROPIC_MODEL_BUSINESS=
ANTHROPIC_MODEL_ENTERPRISE=

# ── DeepSeek (OpenAI-compatible) — cheap Free-plan model ──────────────────────
# When the key is set, the Free plan (and the chat-history summarizer) switch
# from Haiku to DeepSeek; paid plans stay on Anthropic. On any DeepSeek error
# the request retries on ANTHROPIC_MODEL, and with no providers it fails loud.
# ВАЖНО (конфиденциальность): api.deepseek.com обрабатывает данные в КНР.
# Для продакшена юридического продукта укажите DEEPSEEK_BASE_URL западного
# хостинга открытых весов (Together / Fireworks / Nebius / Azure) — тогда
# договоры клиентов не покидают выбранную юрисдикцию.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Model id: deepseek-v4-pro (official API; western hosts use their own ids,
# e.g. deepseek-ai/DeepSeek-V4 — any id containing "deepseek" routes here).
DEEPSEEK_MODEL=
# Force a specific Free-plan model regardless of the auto-switch above.
MODEL_FREE=

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console → APIs & Services → Credentials, and add GOOGLE_REDIRECT_URI to its
# "Authorized redirect URIs". Leave empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Project settings → API. The SERVICE ROLE key bypasses Row Level Security:
# keep it server-side only, never commit it, never expose it to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for uploaded contracts (takes priority over S3/local).
SUPABASE_STORAGE_BUCKET=

# ── Antivirus (optional, SOC2/enterprise) ─────────────────────────────────────
# ClamAV daemon (clamd) для проверки загружаемых договоров и почтовых вложений.
# На Railway/Render — sidecar-контейнер clamav/clamav; укажите его хост.
# Пусто = проверка выключена (magic-byte валидация остаётся всегда).
# Недоступный clamd НЕ блокирует загрузки (fail-open с логом); заражённые
# файлы отклоняются жёстко с аудит-событием file.scan_failed.
CLAMD_HOST=
CLAMD_PORT=3310

# ── Monitoring & intake ───────────────────────────────────────────────────────
# Sentry error monitoring (empty = disabled).
SENTRY_DSN=
# Shared secret for POST /api/inbound/email (empty = endpoint disabled).
# Point your email provider's inbound webhook (Postmark/Mailgun/…) at that URL
# with header X-Inbound-Token: <this value>.
INBOUND_EMAIL_TOKEN=
# Optional (recommended for prod): HMAC signing secret. When set, each inbound
# call must send header X-Inbound-Signature = hex(HMAC-SHA256(secret,
# `${timestamp}.${from}.${sha256(attachment-contents)}`)) and a `timestamp`
# field, within a 5-minute window — so a leaked token alone can't inject a
# document under a spoofed sender, and calls can't be replayed with swapped files.
INBOUND_EMAIL_SIGNING_SECRET=
# Reject inbound mail whose provider-asserted spf/dkim/dmarc field isn't
# "pass" (the `from` used for routing is only trusted after authentication).
# Default TRUE (fail-closed). Set to false ONLY for local experiments.
INBOUND_REQUIRE_SPF_DKIM=true
# Where Enterprise "contact sales" requests and product feedback are delivered.
# REQUIRED in production — empty means those mails are skipped with a log.
CONTACT_EMAIL=

# ── File storage ──────────────────────────────────────────────────────────────
# When S3_BUCKET is set, uploads go to S3 (credentials via the standard AWS
# chain: env vars, shared config, IAM role). When empty, files are stored on
# local disk under DATA_DIR/uploads and served from GET {API_PREFIX}/files/:key.
S3_BUCKET=
S3_REGION=us-east-1
# Optional: custom endpoint (MinIO, R2, …).
S3_ENDPOINT=
# Optional: public base URL for uploaded objects. When empty, presigned GET
# URLs (7 days) are returned.
S3_PUBLIC_URL=

# Outbound email (team invites, signing links). Get a key at https://resend.com
RESEND_API_KEY=
MAIL_FROM="Lexab <onboarding@resend.dev>"
# Public frontend URL used in emailed links
# Until the domain is verified, Resend delivers only to the account owner.
# Set this to that address to route ALL mail there (test mode); remove after
# verifying your domain and pointing MAIL_FROM at it.
MAIL_REDIRECT_TO=
APP_BASE_URL=http://localhost:5173

# Cloud integrations (Settings → Интеграции). Google Drive reuses the Google
# login OAuth client unless a dedicated one is set. All optional.
API_BASE_URL=http://localhost:8080
GOOGLE_API_KEY=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Озвучка ответов ассистента (Gemini 3.1 Flash TTS через Cloud Text-to-Speech;
# фолбэк на gemini-2.5-flash-tts и Chirp3-HD — настройка в src/tts.config.ts).
# Принимаются ДВЕ формы значения:
#  1) JSON-ключ СЕРВИСНОГО АККАУНТА одной строкой — полная цепочка с Gemini-TTS:
#     console.cloud.google.com → проект (нужен включённый биллинг) → включить
#     «Cloud Text-to-Speech API» → IAM → Service Accounts → создать аккаунт с
#     ролью «Vertex AI User» (даёт aiplatform.endpoints.predict — обязательна
#     для Gemini-TTS) → Keys → Add key → JSON.
#  2) Простой API-ключ (AIza…) — Gemini-модели с ним недоступны (403, нужна
#     IAM-роль), озвучка идёт сразу голосами Chirp3-HD (ru/en/de/ar; для uz/kk
#     Chirp-голосов не существует — вернётся понятная ошибка).
# Пусто = пункт «Прочитать вслух» вернёт 503. СЕКРЕТ — только в .env, не сюда.
GOOGLE_TTS_CREDENTIALS_JSON=

# ── E-signatures (Dropbox Sign / HelloSign) ───────────────────────────────────
# When the API key is set, signature requests go through the real provider
# (legally-weighted signatures, provider audit trail, signed PDF). Empty =
# in-app typed-name simulation (NOT legally binding — dev/demo only).
DROPBOX_SIGN_API_KEY=
# 1 = provider SANDBOX: free, but signatures are NOT legally binding.
# ⚠ ПЕРЕД ЗАПУСКОМ обязательно поставить 0 (production) — иначе все подписи
# уходят «понарошку» без какой-либо ошибки. Default is 1 (sandbox).
DROPBOX_SIGN_TEST_MODE=1

# Voyage AI embeddings for the legal RAG corpus (empty = FTS-only search).
VOYAGE_API_KEY=
# Eval-harness only: opt into 429 backoff for the live-path Voyage calls, whose
# back-to-back eval queries exhaust the free tier. Leave EMPTY in production —
# there the live path fails fast and falls back to FTS / RRF order.
RERANK_MAX_RETRIES=
EMBED_QUERY_MAX_RETRIES=

# ── Billing & audit ───────────────────────────────────────────────────────────
# Days a lapsed paid subscription stays in past_due before downgrading to Free.
BILLING_GRACE_DAYS=7
# Failed logins per IP/email in 5 min above which a security alert fires.
AUTH_BRUTEFORCE_ALERT_THRESHOLD=10

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# За nginx/Cloudflare выставьте true (или число доверенных хопов) — иначе в
# журнале действий вместо IP клиента будет адрес прокси. Читается в app.ts
# (fastify trustProxy). Без прокси оставьте пустым.
TRUST_PROXY=
