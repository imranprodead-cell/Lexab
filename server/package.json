{
  "name": "lexai-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LexAI backend — Fastify + Postgres + JWT + S3 + Claude. Implements the API contract in ../BACKEND_HANDOFF.md.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.ts",
    "rag:ingest": "node --env-file-if-exists=.env src/rag/ingest/run-ingest.ts",
    "rag:ingest:uz": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-uz.ts",
    "rag:index": "node --env-file-if-exists=.env src/rag/build-index.ts",
    "rag:embed": "node --env-file-if-exists=.env src/rag/build-index.ts --embed-only",
    "eval": "node --env-file-if-exists=.env evals/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@sentry/node": "^10.64.0",
    "@supabase/supabase-js": "^2.110.1",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.0.0",
    "mammoth": "^1.8.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.2"
  }
}
