{
  "name": "lexab-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lexab backend — Fastify + Postgres + JWT + S3 + Claude. Implements the API contract in ../BACKEND_HANDOFF.md.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "ALLOW_INSECURE_SECRETS=1 node --test test/*.test.ts",
    "smoke": "bash scripts/smoke.sh",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.ts",
    "rag:ingest": "node --env-file-if-exists=.env src/rag/ingest/run-ingest.ts",
    "rag:ingest:uz": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-uz.ts",
    "rag:ingest:kz": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-kz.ts",
    "rag:ingest:de": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-de.ts",
    "rag:ingest:us": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-us.ts",
    "rag:ingest:ca": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-ca.ts",
    "rag:ingest:ae": "node --env-file-if-exists=.env src/rag/ingest/run-ingest-ae.ts",
    "rag:index": "node --env-file-if-exists=.env src/rag/build-index.ts",
    "rag:embed": "node --env-file-if-exists=.env src/rag/build-index.ts --embed-only",
    "eval": "node --env-file-if-exists=.env evals/run-eval.ts",
    "lint": "eslint . --ext ts",
    "verify:db": "node --env-file-if-exists=.env scripts/verify-db.ts",
    "check-deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.112.0",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.11.2",
    "mammoth": "^1.8.0",
    "openai": "^6.46.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.3",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.2"
  }
}
