# Frontend build-time config (Vite). Copy to .env / .env.local.

# "true" = работать на встроенных мок-данных БЕЗ сервера (только для быстрого
# просмотра UI). Для нормальной работы (и в проде) — false: приложение ходит
# в живой API ниже.
VITE_USE_MOCK_API=false

# Base URL of the API server (Fastify, server/). In production point this at
# the deployed API origin, e.g. https://api.your-domain.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Sentry error monitoring for the frontend (empty = disabled).
VITE_SENTRY_DSN=

# Публичный адрес сайта — ЕДИНСТВЕННОЕ место, где живёт домен фронтенда.
# Подставляется на сборке в canonical/hreflang/og/twitter/JSON-LD (index.html),
# в sitemap.xml и robots.txt (scripts/prerender.mjs). Без завершающего слэша.
# Пустое значение = сборка упадёт: пустой canonical хуже отсутствующего.
VITE_SITE_ORIGIN=https://lexabai.com

# ── Раздача сборки на хостинге (scripts/serve-static.mjs) ────────────────────
# Эти переменные читаются НЕ на сборке, а при работе сервера статики, поэтому
# префикса VITE_ у них нет и в браузер они не попадают. Подробности — DEPLOY.md.

# Порт сервера статики. На Railway задаётся платформой, локально — 4173.
# PORT=4173

# Коды доступа через запятую: сайт открывается только по ссылке
# https://lexabai.com/?k=КОД, которая ставит куку на 30 дней.
# ПУСТО = сайт открыт всем — именно так он и открывается на публику.
# Коды удобно завести по аудиториям, чтобы отзывать доступ по одному:
#   SITE_ACCESS_CODES=invest-2026,grant-2026
SITE_ACCESS_CODES=

# Соль для куки доступа. Смена значения разлогинивает ВСЕХ приглашённых сразу —
# это способ отозвать все выданные ссылки одним движением.
SITE_GATE_SECRET=
