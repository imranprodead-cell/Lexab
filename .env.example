# Set to "false" once the real backend is available so the app calls live endpoints.
VITE_USE_MOCK_API=true

# Base URL of the real API. Used only when VITE_USE_MOCK_API is not "true".
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase (browser client). The anon/publishable key is safe to expose;
# access control lives in Row Level Security policies.
# NEVER put the service-role key in frontend env vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error monitoring for the frontend (empty = disabled).
VITE_SENTRY_DSN=
