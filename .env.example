# Frontend build-time config (Vite). Copy to .env / .env.local.

# "true" = работать на встроенных мок-данных БЕЗ сервера (только для быстрого
# просмотра UI). Для нормальной работы (и в проде) — false: приложение ходит
# в живой API ниже.
VITE_USE_MOCK_API=false

# Base URL of the API server (Fastify, server/). In production point this at
# the deployed API origin, e.g. https://api.your-domain.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Sentry error monitoring for the frontend (empty = disabled).
VITE_SENTRY_DSN=

# Публичный адрес сайта — ЕДИНСТВЕННОЕ место, где живёт домен фронтенда.
# Подставляется на сборке в canonical/hreflang/og/twitter/JSON-LD (index.html),
# в sitemap.xml и robots.txt (scripts/prerender.mjs). Без завершающего слэша.
# Пустое значение = сборка упадёт: пустой canonical хуже отсутствующего.
VITE_SITE_ORIGIN=https://lexabai.com
